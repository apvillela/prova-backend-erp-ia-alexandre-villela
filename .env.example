## - APP - ##
# APP_HOST='0.0.0.0'
# APP_PORT=8000
# APP_TITLE='ERP API'
# APP_WORKERS=1
# WORKER_THREAD_POOL_SIZE=40

## - Env Control - ##
# APP_ENV='DEV'

## - PostgreSQL - ##
# POSTGRES_HOST='postgres-erp-api'
# POSTGRES_PORT=5432
# POSTGRES_USER='erp'
POSTGRES_PASS='erp'
# POSTGRES_DB='erp'
# POSTGRES_ECHO=false
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10

## - Redis - ##
# REDIS_HOST='redis-erp-api'
# REDIS_PORT=6379
# REDIS_PASS=
# REDIS_DB=0

## - Resumo - ##
# RESUMO_TIMEOUT=1.0
# RESUMO_TENTATIVAS=2

## - Estoque - ##
# ESTOQUE_BAIXO_LIMITE=10

## - Cache - ##
# CACHE_TTL_PRODUTOS=30

## - Auth - ##
# AUTH_USERNAME='admin'
AUTH_PASSWORD='admin'
# gerar com: openssl rand -hex 32
JWT_SECRET='change-me'
# JWT_ALGORITHM='HS256'
# JWT_EXPIRE_MINUTES=60

## - Metrics - ##
# METRICS_ENABLED=true

## - CORS - ##
# CORS_ORIGINS='origin1,origin2'

## - Logging (Local) - ##
# LOG_LEVEL='INFO'
# LOG_DIR_PATH='logs'

## - Development - ##
# DEV_UVICORN_RELOAD=false

## - Docker Compose Mappings - ##
# FRONTEND_PORT=3000
# COMPOSE_APP_1_PORTS=8000
# COMPOSE_APP_1_MAP_LOGS_DIR='./logs'
# COMPOSE_APP_1_IMAGE_VERSION='latest'
# COMPOSE_POSTGRES_IMAGE_VERSION='16-alpine'
# COMPOSE_POSTGRES_PORTS=127.0.0.1:5432
# COMPOSE_REDIS_IMAGE_VERSION='7-alpine'
# COMPOSE_REDIS_PORTS=127.0.0.1:6379
